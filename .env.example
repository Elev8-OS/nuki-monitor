# --- Pflicht ---------------------------------------------------------------
# Token aus Nuki Web: Menue > API. Wird ungueltig, wenn das Kontopasswort wechselt.
NUKI_API_TOKEN=
# Auf Railway als Referenz eintragen: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# --- Zugriffsschutz --------------------------------------------------------
DASHBOARD_USER=ops
DASHBOARD_PASSWORD=
# Eigenes Token fuer die Sonden vor Ort (nicht dasselbe wie oben).
PROBE_TOKEN=

# --- Alarme ----------------------------------------------------------------
# Generischer Webhook: bekommt JSON per POST. In Make, n8n oder Slack einhaengen.
ALERT_WEBHOOK_URL=
# Wird als Header X-Monitor-Secret mitgeschickt, damit der Empfaenger pruefen kann.
ALERT_WEBHOOK_SECRET=
# Erst nach so vielen Minuten offline wird alarmiert.
ALERT_AFTER_MINUTES=15
# So viele Schloesser innerhalb des Fensters loesen den Flaechenalarm aus.
FLEET_ALERT_THRESHOLD=3
FLEET_ALERT_WINDOW_MINUTES=10
# Erscheint als dashboard_url in jedem Alarm.
PUBLIC_URL=

# --- Messung ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
SAMPLE_INTERVAL_MINUTES=15
SAMPLE_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=365

# Nur noetig, wenn die oeffentliche Railway-Proxy-URL statt der internen genutzt wird.
DATABASE_SSL=false
